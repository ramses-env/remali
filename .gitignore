# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node / Frontend
node_modules/
dist-ssr/
coverage/
.cache/
.eslintcache
.turbo/

# El build del frontend (frontend/dist/) NO se versiona: la imagen de Docker lo
# reconstruye en la etapa frontend-build (ver Dockerfile) y lo copia a la imagen.
# Versionarlo solo mete artefactos que quedan obsoletos. Ignorado en frontend/.gitignore.

# Python / Django
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
db.sqlite3
media/
staticfiles/

# Entornos virtuales (Ignoramos todos los posibles nombres)
venv/
.venv/
env/

# Variables de entorno (¡Seguridad!)
.env
.env.*
!.env.example
.env.dev


# OS / Editores
.idea/
.vscode/
.DS_Store
Thumbs.db

# Respaldos de BD (dumps de datos, no se versionan)
backups/
backend/backup*.json
backend/backup*.json.gz
backend/*backup*.json
backend/*backup*.json.gz

# Config local de herramientas (Claude Code, etc.)
.claude/
