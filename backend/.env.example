# Plantilla de variables de entorno de REMALI.
#
# Este archivo SÍ se versiona (ver la excepción `!.env.example` en .gitignore);
# `.env` y `.env.dev` NO. Copia este archivo a `.env` y pon ahí los valores
# reales — nunca al revés, y nunca valores reales en este archivo.
#
#   cp backend/.env.example backend/.env
#
# En producción estas variables se cargan en Railway (pestaña Variables), no
# desde un archivo.

# ─── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
DEBUG=False
# Listas separadas por comas. Se SUMAN a los valores fijos de settings.py
# (remali.mx, www.remali.mx, el dominio de Railway y localhost), así que
# normalmente puedes dejarlas vacías.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Sitio en construcción: con True, todo el tráfico público ve una sola página de
# aviso (el admin de Django sigue accesible). Ponlo en False y vuelve a desplegar
# para mostrar el sitio real.
# En producción viene encendido solo. Ponlo en False cuando el sitio real esté listo.
MODO_CONSTRUCCION=False

# URLs públicas (se usan en correos y enlaces de verificación)
FRONTEND_URL=https://remali.mx
BACKEND_URL=https://remali.mx

# ─── Base de datos ─────────────────────────────────────────────────────────
# En Railway basta con agregar el servicio MySQL: MYSQL_URL / MYSQLHOST y demás
# las inyecta solo. En local se pueden usar las DB_* sueltas.
MYSQL_URL=
DB_NAME=remali
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ─── Cloudinary (imágenes y respaldos) ─────────────────────────────────────
# El API_SECRET da control total del almacenamiento: puede borrar la evidencia
# fotográfica de las rentas. Va SOLO aquí o en Railway, nunca en el repo.
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=tu-api-key
CLOUDINARY_API_SECRET=tu-api-secret
CLOUDINARY_UPLOAD_PRESET=remali-upload

# ─── Correo (avisos, verificación, acuse de cotización) ────────────────────
# Las credenciales SMTP van en el entorno, NO en la configuración del panel:
# ahí quedarían en texto plano en la base de datos.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-correo@ejemplo.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=REMALI <no-reply@remali.mx>

# ─── Entrar con Google ─────────────────────────────────────────────────────
# El client ID es público (viaja en el HTML del botón). El client secret NO se
# usa en este flujo: el backend verifica el ID token contra las llaves públicas
# de Google, así que no hace falta ponerlo en ningún lado.
GOOGLE_CLIENT_ID=

# ─── Asistente de IA (chat del panel) ──────────────────────────────────────
# El backend habla con un modelo por API compatible con OpenAI. El MISMO código
# sirve en local y en Railway; solo cambian estas variables.
#
#   - LOCAL (gratis, sin clave) con Ollama:
#       AI_BASE_URL=http://localhost:11434/v1
#       AI_API_KEY=
#       AI_MODEL=qwen2.5:3b          (o qwen2.5:7b)
#     Requiere Ollama corriendo:  ollama serve  +  ollama pull qwen2.5:3b
#
#   - RAILWAY / producción: Ollama NO corre bien ahí (sin GPU). Usa una API
#     hospedada con capa GRATIS. Recomendado Groq (rápido y gratis):
#       AI_BASE_URL=https://api.groq.com/openai/v1
#       AI_API_KEY=gsk_...           (crea una gratis en console.groq.com)
#       AI_MODEL=llama-3.3-70b-versatile
#     Alternativa Google Gemini (capa gratis, compatible OpenAI):
#       AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#       AI_API_KEY=...               (aistudio.google.com/app/apikey)
#       AI_MODEL=gemini-1.5-flash
#
# Si se dejan vacías, el código usa Ollama local por defecto. La clave vive
# SOLO aquí (servidor); nunca en el frontend.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ─── Geocodificación de direcciones (autocompletado) ───────────────────────
# Proveedor: 'photon' (default, gratis OSM) | 'nominatim' (gratis OSM) | 'google'.
GEOCODING_PROVIDER=photon
GEOCODING_COUNTRY=mx
GEOCODING_USER_AGENT=remali/1.0
# Solo para GEOCODING_PROVIDER=google (Places API New · Text Search):
#   1) Habilita "Places API (New)" en tu proyecto de Google Cloud (con facturación).
#   2) Usa una API key SERVER-SIDE: en Google Cloud, Application restrictions = "None"
#      o "IP addresses" (NUNCA "HTTP referrers": esta llamada la hace el servidor,
#      sin referrer, y Google la bloquearía). API restrictions = "Places API (New)".
#   3) Pega esa key aquí (y la misma en Railway para producción).
GOOGLE_MAPS_API_KEY=

# ─── Otros ─────────────────────────────────────────────────────────────────
# Correos que reciben los avisos de escalación (separados por comas).
ESCALACION_EMAILS=
# Vigencia de los enlaces, en segundos.
PASSWORD_RESET_TIMEOUT=86400
EMAIL_VERIFICATION_TIMEOUT=86400
# Redis para cache compartido + WebSockets entre workers.
# Local con Docker Compose del repo: redis://127.0.0.1:6379/1
# Railway: pega aquí la URL del servicio Redis que te entregue la plataforma.
REDIS_URL=
# Solo para pruebas locales de respaldos. Si va vacía, usa ./backups
BACKUP_LOCAL_DIR=backups

# ─── Endurecimiento HTTP en producción (opcionales; estos defaults ya salen de settings.py)
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=1
# SECURE_HSTS_PRELOAD=0
# SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
# X_FRAME_OPTIONS=DENY

# ─── Servidor (gunicorn, se leen en el Dockerfile) ─────────────────────────
# Si el plan tiene poca RAM, baja WEB_CONCURRENCY a 1: es la palanca más
# directa para reducir el consumo de memoria, que es lo que más se cobra.
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=60
