SECRET_KEY=pon_aqui_un_secreto_seguro
DEBUG=0
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://tu-dominio.com,https://www.tu-dominio.com

# Base de datos MySQL
DB_NAME=remali_db
DB_USER=usuario
DB_PASSWORD=contraseña
DB_HOST=localhost
DB_PORT=3306
# DB_SOCKET=/cloudsql/proyecto:region:instancia  # opcional

# URLs públicas
FRONTEND_URL=https://frontend.tu-dominio.com
BACKEND_URL=https://api.tu-dominio.com

# Email (opcional; si no se configura usa consola)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@tu-dominio.com

# Seguridad avanzada (opcional)
SECURE_SSL_REDIRECT=1

# Ruta de volumen en Railway (si creas un Volume)
RAILWAY_VOLUME_PATH=/mnt/storage
# Opcional: fuerza una ruta custom para media
# MEDIA_ROOT=/mnt/storage/media
